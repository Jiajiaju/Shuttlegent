# C++ and Unreal source files always use LF, regardless of core.autocrlf
*.cpp text eol=lf
*.h text eol=lf
*.inl text eol=lf
*.cs text eol=lf
*.usf text eol=lf
*.ush text eol=lf

# Unreal localization files keep the bytes the gather commandlets write:
# .manifest and .archive are UTF-16LE, .po is UTF-8 with BOM, .locres and .locmeta are binary
*.manifest -text
*.archive -text
*.po -text
*.locres binary
*.locmeta binary
